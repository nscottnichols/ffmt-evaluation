echo 'g++ -std=c++20 -Wall -Werror -fno-fast-math -Iinclude  -isystem third_party/fmt/include -x hip --offload-arch=gfx90a -O2' | cmp -s - build/.flags || echo 'g++ -std=c++20 -Wall -Werror -fno-fast-math -Iinclude  -isystem third_party/fmt/include -x hip --offload-arch=gfx90a -O2' > build/.flags
