expected=$(git -C "third_party/fmt" rev-parse --verify '0fc31633e7d53ac895ae0a688b83b7d44f0b0c1f^{commit}') && \
 actual=$(git -C "third_party/fmt" rev-parse HEAD) && \
 test "$actual" = "$expected" || \
 { echo 'fmt checkout does not match FMT_REF; supply a clean pinned checkout.' >&2; exit 1; }
test -z "$(git -C "third_party/fmt" status --porcelain)" || \
 { echo 'fmt checkout has local changes; preserve it and supply a clean pinned checkout.' >&2; exit 1; }
