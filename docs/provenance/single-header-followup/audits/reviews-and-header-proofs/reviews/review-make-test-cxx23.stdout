echo 'g++ -std=c++20 -Wall -Werror -fno-fast-math -Iinclude  -isystem third_party/fmt/include -fsycl  -O2' | cmp -s - build/.flags || echo 'g++ -std=c++20 -Wall -Werror -fno-fast-math -Iinclude  -isystem third_party/fmt/include -fsycl  -O2' > build/.flags
expected=$(git -C "third_party/fmt" rev-parse --verify '0fc31633e7d53ac895ae0a688b83b7d44f0b0c1f^{commit}') && \
 actual=$(git -C "third_party/fmt" rev-parse HEAD) && \
 test "$actual" = "$expected" || \
 { echo 'fmt checkout does not match FMT_REF; supply a clean pinned checkout.' >&2; exit 1; }
test -z "$(git -C "third_party/fmt" status --porcelain)" || \
 { echo 'fmt checkout has local changes; preserve it and supply a clean pinned checkout.' >&2; exit 1; }
g++ -std=c++20 -Wall -fno-fast-math -Iinclude -isystem third_party/fmt/include -O2 -c third_party/fmt/src/format.cc -o build/fmt.o
g++ -std=c++20 -Wall -Werror -fno-fast-math -Iinclude  -isystem third_party/fmt/include -O2 -std=c++23  -UNDEBUG test/direct/test_std23.cpp build/fmt.o -o build/test_std23
fail=0; for bin in build/test_std23; do t0=$(perl -MTime::HiRes=time -e 'printf("%d\n", time() * 1e9)'); ./$bin; rc=$?; ms=$(( ($(perl -MTime::HiRes=time -e 'printf("%d\n", time() * 1e9)') - t0) / 1000000 )); if [ $rc -eq 0 ]; then echo "${bin#build/}: PASS (${ms}ms)"; elif [ $rc -eq 77 ] && [[ "         build/test_core_int128      build/test_engine_bitint    build/test_engine_quad               build/test_std23 " == *" $bin "* ]]; then echo "${bin#build/}: SKIP (optional compiler capability)"; else echo "${bin#build/}: FAIL (${ms}ms)"; fail=1; fi; done; exit $fail
