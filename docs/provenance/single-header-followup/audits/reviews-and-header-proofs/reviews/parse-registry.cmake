file(STRINGS "/vast/projects/datascience/nnichols/ffmt_project/ffmt/test/direct/tests.mk" declarations)
foreach(declaration IN LISTS declarations)
  if(declaration MATCHES "^(FFMT_[A-Za-z0-9_]+)[ \t]*:=[ \t]*(.*)$")
    string(STRIP "${CMAKE_MATCH_2}" value)
    separate_arguments(value UNIX_COMMAND "${value}")
    set("${CMAKE_MATCH_1}" "${value}")
  endif()
endforeach()
list(LENGTH FFMT_DIRECT_TESTS default_count)
list(LENGTH FFMT_DIRECT_CXX23_TESTS optional_count)
message("default=${default_count}; cxx23=${optional_count}; flags=${FFMT_DIRECT_FLAGS_core_floating_portable}; ref=${FFMT_DIRECT_REFERENCE_chrono}; source=${FFMT_DIRECT_SOURCE_core_floating_portable}")
